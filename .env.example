# Copy to .env. Read by ./start.sh; values remain server-side.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENMOLSPEC_LLM_MODEL=
# OPENMOLSPEC_MAX_OUTPUT_TOKENS=4096
# OPENMOLSPEC_RUN_TOKEN_LIMIT=64000
# OPENMOLSPEC_CALCULATION_WAIT_SECONDS=1800

# An OpenAI-compatible local service can omit the API key if it does not require one.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENMOLSPEC_LLM_MODEL=your-tool-capable-model

OPENMOLSPEC_DEVICE=auto
# OPENMOLSPEC_ROOT=/absolute/path/to/full/openmolspec-assets
# OPENMOLSPEC_UPLOAD_DIR=.openmolspec/uploads

# For separately launched/containerized services; dev.py derives its local URLs from ports.
# OPENMOLSPEC_CHEMISTRY_URL=http://127.0.0.1:8001
# OPENMOLSPEC_API_URL=http://127.0.0.1:8000

# Native launch (provide a fresh PostgreSQL database).
OPENMOLSPEC_DATABASE_URL=postgresql://molspec:local-development-password@127.0.0.1:5432/molspec
# OPENMOLSPEC_ENV=development
# OPENMOLSPEC_MOCK_SSO=1
# OPENMOLSPEC_SESSION_HOURS=24
# Daily allowance, resets at midnight Asia/Shanghai.
# OPENMOLSPEC_FREE_CREDITS=20
# OPENMOLSPEC_CREDIT_RULE_VERSION=v2

# Local Compose uses the postgres service hostname and requires a shared private key.
# OPENMOLSPEC_POSTGRES_PASSWORD=local-development-password
# OPENMOLSPEC_COMPOSE_DATABASE_URL=postgresql://molspec:local-development-password@postgres:5432/molspec
# OPENMOLSPEC_INTERNAL_KEY=generate-with-openssl-rand-hex-32
# OPENMOLSPEC_MCP_LOCAL_URL=http://127.0.0.1:3000/api/mcp
# OPENMOLSPEC_MCP_CLOUD_URL=
# OPENMOLSPEC_ALLOWED_ORIGINS=http://127.0.0.1:3000
